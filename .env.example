# ─── VEYRN CHESS ENVIRONMENT CONFIGURATION ───

# 1. PRODUCTION SIGNALING + WAITLIST STORAGE
# Create a free Upstash Redis database and add both values in Vercel.
# Local development uses in-memory signaling and a local .data/waitlist.json file.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 2. TURN SERVERS (OPTIONAL relay for restrictive NATs & VPNs)
# Get free TURN service from Metered.ca (50GB free/mo), Cloudflare Calls, Twilio, or OpenRelay
# Multiple URLs can be comma-separated (UDP, TCP, TURNS on port 443)
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Optional single-URL fallback (backwards compatibility)
# NEXT_PUBLIC_TURN_URL=
